<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PosSaas.Domain\PosSaas.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- EF Core + PostgreSQL (see README "Swapping in EF Core + PostgreSQL"; this project ran on
       SQL Server originally, migrated to Postgres - see git history / the README's migration
       note for what changed and why it was a clean swap), on .NET 10 / EF Core 10.
       PosSaasDbContext.cs / EfRepository.cs are written by hand against the real EF Core API
       surface and were already provider-agnostic (no SQL-Server-specific column types, raw SQL,
       or execution-strategy config anywhere), so this is a one-line provider swap in Program.cs
       plus this package. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 pulls in Microsoft.EntityFrameworkCore
         10.0.4 transitively, one patch behind the 10.0.11 every other EF Core package here is
         pinned to - an explicit direct reference forces NuGet to unify on 10.0.11 everywhere
         instead of silently picking whichever version happens to be "primary" per project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.18" />
  </ItemGroup>

</Project>
