# appsettings.json holds a real, live connection string (including a database password) on
# this machine - never committed. appsettings.Example.json (tracked) ships the same structure
# with safe local-dev placeholder values; copy it to appsettings.json and fill in your own
# connection string/JWT secret to run this locally.
appsettings.json
appsettings.*.json
!appsettings.Example.json

